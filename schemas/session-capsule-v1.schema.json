{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Session Capsule v1",
  "type": "object",
  "required": [
    "session_id",
    "project",
    "repository",
    "base_commit",
    "final_commit",
    "branch",
    "agent",
    "model",
    "provider",
    "started_at",
    "ended_at",
    "objective",
    "files_read",
    "files_changed",
    "commits",
    "decisions",
    "commands",
    "tests",
    "failures",
    "reverts",
    "deployments",
    "artifacts",
    "skills_used",
    "skills_created",
    "workflows_used",
    "workflows_created",
    "claims",
    "known_gaps",
    "next_actions"
  ],
  "properties": {
    "session_id": { "type": "string" },
    "project": { "type": "string" },
    "repository": { "type": "string" },
    "base_commit": { "type": "string" },
    "final_commit": { "type": "string" },
    "branch": { "type": "string" },
    "agent": { "type": "string" },
    "model": { "type": "string" },
    "provider": { "type": "string" },
    "started_at": { "type": "string", "format": "date-time" },
    "ended_at": { "type": "string", "format": "date-time" },
    "objective": { "type": "string" },
    "files_read": { "type": "array", "items": { "type": "string" } },
    "files_changed": { "type": "array", "items": { "type": "string" } },
    "commits": { "type": "array", "items": { "type": "string" } },
    "decisions": { "type": "array", "items": { "$ref": "#/definitions/Decision" } },
    "commands": { "type": "array", "items": { "type": "string" } },
    "tests": { "type": "array", "items": { "type": "string" } },
    "failures": { "type": "array", "items": { "type": "string" } },
    "reverts": { "type": "array", "items": { "type": "string" } },
    "deployments": { "type": "array", "items": { "type": "string" } },
    "artifacts": { "type": "array", "items": { "type": "string" } },
    "skills_used": { "type": "array", "items": { "type": "string" } },
    "skills_created": { "type": "array", "items": { "type": "string" } },
    "workflows_used": { "type": "array", "items": { "type": "string" } },
    "workflows_created": { "type": "array", "items": { "type": "string" } },
    "claims": { "type": "array", "items": { "$ref": "#/definitions/Claim" } },
    "known_gaps": { "type": "array", "items": { "type": "string" } },
    "next_actions": { "type": "array", "items": { "type": "string" } }
  },
  "definitions": {
    "Decision": {
      "type": "object",
      "required": ["type", "text"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["FACT", "INFERENCE", "USER_STATEMENT", "AGENT_CLAIM", "VERIFIED_RESULT"]
        },
        "text": { "type": "string" }
      }
    },
    "Claim": {
      "type": "object",
      "required": ["claim_id", "text", "category", "status", "evidence", "origin", "confidence", "safe_for_public", "safe_for_cv", "limitations"],
      "properties": {
        "claim_id": { "type": "string" },
        "text": { "type": "string" },
        "category": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["VERIFIED", "PARTIAL", "UNVERIFIED", "CONTRADICTED", "STALE"]
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/definitions/Evidence" }
        },
        "origin": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "safe_for_public": { "type": "boolean" },
        "safe_for_cv": { "type": "boolean" },
        "limitations": { "type": "string" }
      }
    },
    "Evidence": {
      "type": "object",
      "properties": {
        "git_commit": { "type": "string" },
        "file_path": { "type": "string" },
        "line_range": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 },
        "test_result": { "type": "string" },
        "CI_run": { "type": "string" },
        "deployment": { "type": "string" },
        "screenshot": { "type": "string" },
        "benchmark": { "type": "string" },
        "external_source": { "type": "string" }
      }
    }
  }
}
